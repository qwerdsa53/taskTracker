# syntax=docker/dockerfile:1.7

# ---------- Build stage ----------
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app

COPY gradlew .
RUN chmod +x gradlew
COPY gradle gradle
COPY build.gradle.kts settings.gradle.kts ./
COPY task-tracker-common task-tracker-common
COPY task-tracker-openapi task-tracker-openapi
COPY task-tracker-api task-tracker-api
COPY task-tracker-scheduler task-tracker-scheduler

RUN --mount=type=cache,target=/root/.gradle,sharing=locked \
    ./gradlew :task-tracker-scheduler:bootJar -x test --no-daemon

# ---------- Layer extraction stage ----------
FROM eclipse-temurin:21-jre-alpine AS layers
WORKDIR /app
COPY --from=build /app/task-tracker-scheduler/build/libs/task-tracker-scheduler-*.jar app.jar
RUN java -Djarmode=tools -jar app.jar extract --layers --launcher --destination /app/extracted

# ---------- Runtime stage ----------
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN apk add --no-cache tini curl \
 && addgroup -S app && adduser -S app -G app \
 && chown -R app:app /app

USER app

COPY --from=layers --chown=app:app /app/extracted/dependencies/ ./
COPY --from=layers --chown=app:app /app/extracted/spring-boot-loader/ ./
COPY --from=layers --chown=app:app /app/extracted/snapshot-dependencies/ ./
COPY --from=layers --chown=app:app /app/extracted/application/ ./

ENV JAVA_TOOL_OPTIONS="\
-XX:+UseContainerSupport \
-XX:MaxRAMPercentage=75.0 \
-XX:+ExitOnOutOfMemoryError \
-XX:+AlwaysActAsServerClassMachine \
-XX:TieredStopAtLevel=1 \
-Djava.security.egd=file:/dev/./urandom \
-Dspring.backgroundpreinitializer.ignore=true"

EXPOSE 8081

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
  CMD curl -fsS http://localhost:8081/actuator/health/readiness || exit 1

ENTRYPOINT ["/sbin/tini", "--", "java", "org.springframework.boot.loader.launch.JarLauncher"]

# Copy this file to .env and fill in the values.
# .env is gitignored - never commit real secrets.

# Spring
SPRING_PROFILES_ACTIVE=local
DDL_AUTO=update      # update | create | validate | none

# Docker image (CI sets this to commit SHA; empty = build locally)
IMAGE_TAG=

# Number of API replicas (nginx load balances between them)
API_REPLICAS=1

# API server
SERVER_PORT=8080
SCHEDULER_SERVER_PORT=8081

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tasktracker
DB_USER=postgres
DB_PASSWORD=postgres
DB_INTEGRATION_PORT=5433

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=your-email@yandex.ru
MAIL_PASSWORD=your-app-password
# MAIL_FROM=your-email@yandex.ru  # defaults to MAIL_USERNAME
APP_MAIL_ENABLED=false

# JWT
JWT_SECRET=change-me-min-32-chars-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Temporal (scheduler)
TEMPORAL_ENABLED=false
TEMPORAL_TARGET=127.0.0.1:7233
